generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  userId        String    @id @default(cuid())
  email         String    @unique
  password      String    @default("")
  displayName   String
  role          String    @default("user") // admin, contentAdmin, user
  authProvider  String    @default("credentials") // credentials, azure-ad
  externalId    String?
  isActive      Boolean   @default(true)
  registeredAt  DateTime  @default(now())
  lastLoginAt   DateTime?
  attempts      AssessmentAttempt[]
  feedbacks     Feedback[]
}

model Feedback {
  feedbackId String   @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [userId])
  name       String?
  email      String?
  rating     Int?
  content    String
  createdAt  DateTime @default(now())
}

model BankVersion {
  versionId        Int      @id @default(autoincrement())
  status           String   // "live", "archived"
  description      String?
  publishedBy      String
  publishedAt      DateTime @default(now())
  questionCount    Int
  dimensionConfig  Json
  competencyConfig Json
  questions        Json
  attempts         AssessmentAttempt[]
}

model AssessmentAttempt {
  attemptId      String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [userId])
  bankVersionId  Int
  bankVersion    BankVersion @relation(fields: [bankVersionId], references: [versionId])
  status         String    // "in_progress", "completed", "deleted"
  selectedQuestionIds Json  @default("[]")
  toolsDaily     Json      @default("[]")
  toolsWeekly    Json      @default("[]")
  startTime      DateTime  @default(now())
  endTime        DateTime?
  timeUsedSeconds Int      @default(0)
  isPaused       Boolean   @default(false)
  lastResumedAt  DateTime?
  answers        Json      @default("{}")
  dimScores      Json?
  overallScore   Float?
  badge          String?
  badgeExpiresAt DateTime?
  reactions      QuestionReaction[]
}

model QuestionReaction {
  reactionId     String    @id @default(cuid())
  attemptId      String
  attempt        AssessmentAttempt @relation(fields: [attemptId], references: [attemptId])
  questionId     String
  vote           String?   // "up", "down", null
  comment        String?
  createdAt      DateTime  @default(now())
}
